FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    build-essential cmake ninja-build pkg-config git curl wget ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirement.txt /tmp/requirement.txt
RUN if [ -s /tmp/requirement.txt ]; then \
      python3 -m pip install --upgrade pip && \
      # CPU 컨테이너는 XPU 스택이 없으니 torch를 CPU용으로 깔거나, 필요 없으면 같이 제외
      grep -v -E '^(torch|torchvision|torchaudio|pytorch-triton-xpu)\b' /tmp/requirement.txt > /tmp/req.notorch.txt || true; \
      if [ -s /tmp/req.notorch.txt ]; then python3 -m pip install -r /tmp/req.notorch.txt; fi \
    ; fi

ENV PYTHONUNBUFFERED=1 PYTHONPATH=/workspace
SHELL ["/bin/bash", "-lc"]
