FROM intel/intel-extension-for-pytorch:2.8.10-xpu-idp-base

# conda env(idp)의 python/pip을 항상 먼저 잡히게 + 시스템 경로에 링크
ENV PATH=/opt/conda/envs/idp/bin:/opt/conda/bin:$PATH
RUN ln -sf /opt/conda/envs/idp/bin/python /usr/local/bin/python \
 && ln -sf /opt/conda/envs/idp/bin/pip    /usr/local/bin/pip

# 빌드 도구 + Intel oneAPI repo 등록 + oneDNN(SYCL interop) 설치
# (문제난 RUN 한 블록을 이걸로 교체)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg build-essential cmake ninja-build pkg-config git \
 && install -d -m 0755 /usr/share/keyrings /etc/apt/sources.list.d \
 && /usr/bin/curl -fsSL --retry 5 --retry-connrefused \
      https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/oneapi-archive-keyring.gpg \
 && echo 'deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main' \
    > /etc/apt/sources.list.d/oneAPI.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends intel-oneapi-dnnl-devel \
 && ldconfig \
 && rm -rf /var/lib/apt/lists/*


WORKDIR /workspace

# 프로젝트 의존성 설치 (XPU 스택은 이미지에 있으므로 제외)
COPY requirement.txt /tmp/requirement.txt
RUN if [ -s /tmp/requirement.txt ]; then \
      python -m pip install --upgrade pip && \
      grep -v -E '^(torch|torchvision|torchaudio|pytorch-triton-xpu)\b' /tmp/requirement.txt > /tmp/req.notorch.txt || true; \
      if [ -s /tmp/req.notorch.txt ]; then pip install -r /tmp/req.notorch.txt; fi \
    ; fi

SHELL ["/bin/bash", "-lc"]
